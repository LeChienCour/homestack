# Copia a terraform.tfvars y rellena.
# IMPORTANTE: domain se pasa como variable de entorno — NO lo pongas en este archivo.
#
# Antes de correr terraform:
#   export TF_VAR_domain="tudominio.com"
#
# El Makefile tiene el target `tf-aws-env` para recordarte qué exportar.

aws_region            = "us-east-1"
aws_profile           = "homestack"      # perfil en ~/.aws/credentials
from_email_local_part = "noreply"
